{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Kadr",
  "version": "0.5.0",
  "identifier": "app.kadr",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Kadr",
        "width": 800,
        "height": 600
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["helpers/**/*", "resources/geobase.tsv"],
    "linux": {
      "deb": {
        "depends": ["ffmpeg", "libimage-exiftool-perl"]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
